<%@ page language="java"
    contentType="text/html; charset=UTF-8"
    pageEncoding="UTF-8"%>

<!DOCTYPE html>
<html>

<head>

    <meta charset="UTF-8">

    <title>GameRanker</title>

    <link rel="stylesheet" href="style.css">

</head>

<body>

<header class="main-header">

    <div class="logo">
        🎮 GameRanker
    </div>

    <nav>
        <a href="index.jsp">Home</a>
        <a href="games">Rankings</a>
    </nav>

</header>


<section class="hero">

    <div class="hero-content">

        <div class="hero-badge">
            🎮 GAME REVIEW SYSTEM
        </div>

        <h1>
            Rate. Review.<br>
            <span>Rank.</span>
        </h1>

        <p>
            Discover the greatest games and rate them based on
            Story, Gameplay, Graphics, Sound and Replayability.
        </p>

        <div class="hero-buttons">

            <a href="games" class="primary-btn">
                🏆 Explore Rankings
            </a>

            <a href="games" class="secondary-btn">
                ⭐ Rate a Game
            </a>

        </div>

    </div>

</section>


<section class="features">

    <div class="feature-card">

        <div class="feature-icon">📖</div>

        <h3>Story</h3>

        <p>
            Rate the story and narrative experience.
        </p>

    </div>


    <div class="feature-card">

        <div class="feature-icon">🎮</div>

        <h3>Gameplay</h3>

        <p>
            Judge how fun and engaging the gameplay is.
        </p>

    </div>


    <div class="feature-card">

        <div class="feature-icon">🎨</div>

        <h3>Graphics</h3>

        <p>
            Rate the visual quality and design.
        </p>

    </div>


    <div class="feature-card">

        <div class="feature-icon">🔊</div>

        <h3>Sound</h3>

        <p>
            Rate music, sound effects and audio.
        </p>

    </div>


    <div class="feature-card">

        <div class="feature-icon">🔄</div>

        <h3>Replayability</h3>

        <p>
            How enjoyable is the game after finishing it?
        </p>

    </div>

</section>


<footer>

    <p>
        © 2026 GameRanker | Game Review System
    </p>

</footer>


</body>

</html>